{
 "doctype": "DocType",
 "name": "Housekeeping Task",
 "module": "AlphaX Hospitality",
 "custom": 0,
 "istable": 0,
 "engine": "InnoDB",
 "allow_rename": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "property",
   "label": "Property",
   "fieldtype": "Link",
   "options": "Hotel Property",
   "reqd": 1
  },
  {
   "fieldname": "room",
   "label": "Room",
   "fieldtype": "Link",
   "options": "Room",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "task_date",
   "label": "Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "task_type",
   "label": "Type",
   "fieldtype": "Select",
   "options": "Departure Clean\nStayover Clean\nDeep Clean\nInspection\nTurndown\nMaintenance",
   "default": "Departure Clean",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "label": "Priority",
   "fieldtype": "Select",
   "options": "Low\nNormal\nHigh\nUrgent",
   "default": "Normal"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Pending\nIn Progress\nDone\nInspected\nBlocked",
   "default": "Pending",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sb_assign",
   "label": "Assignment",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "assigned_to",
   "label": "Assigned To",
   "fieldtype": "Link",
   "options": "Employee",
   "in_list_view": 1
  },
  {
   "fieldname": "started_at",
   "label": "Started",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "cb2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "completed_at",
   "label": "Completed",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "inspected_by",
   "label": "Inspected By",
   "fieldtype": "Link",
   "options": "Employee"
  },
  {
   "fieldname": "minutes_taken",
   "label": "Minutes",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "sb_notes",
   "label": "Notes",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  }
 ],
 "permissions": [
  {
   "role": "Hotel Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Front Desk Agent",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "autoname": "format:HK-{YY}{MM}{DD}-{####}"
}